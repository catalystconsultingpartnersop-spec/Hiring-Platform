# Copy these into Vercel: Project -> Settings -> Environment Variables

# Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Your admin password for /admin
ADMIN_PASSWORD=

# A long random string (at least 32 characters) used to sign logins
SESSION_SECRET=

# The site's public address, no trailing slash, e.g. https://hiring-platform.vercel.app
SITE_URL=

# Stripe: Developers -> API keys (secret key)
STRIPE_SECRET_KEY=
# Stripe: Developers -> Webhooks (optional backup; endpoint = SITE_URL/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=

# Resend (same account as the booking app)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_EMAIL=

# The name shown on the site until you pick one
NEXT_PUBLIC_BRAND_NAME=

# Google sign-in for business owners (Google Cloud -> APIs & Services -> Credentials)
# Authorized redirect URI: SITE_URL/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
